# DeepSeek API（翻译、总结、启示生成都需要）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 飞书开放平台配置（可选）
# 1. 创建飞书自建应用：https://open.feishu.cn/app
# 2. 获取 App ID 和 App Secret
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格配置（可选）
# 1. 创建多维表格：https://example.feishu.cn/base/
# 2. 从 URL 中提取 app_token：https://example.feishu.cn/base/{app_token}
# 3. 打开表格，从 URL 中提取 table_id：https://example.feishu.cn/base/{app_token}?table={table_id}
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# 飞书域名配置（可选，用于生成文档链接）
# 从你的飞书多维表格 URL 中提取：https://{DOMAIN}.feishu.cn/base/...
# 例如：rcns5ppx1h0z
FEISHU_DOMAIN=

# 飞书 Webhook 通知（可选，用于推送处理结果）
# 1. 创建飞书群聊
# 2. 添加「自定义机器人」
# 3. 复制 Webhook URL
FEISHU_WEBHOOK_URL=

# 飞书文件夹配置（可选，Daily Brief 文档自动保存位置）
# 1. 创建飞书文件夹并设置为公开/共享
# 2. 从文件夹 URL 中提取 token：https://example.feishu.cn/drive/folder/{folder_token}
# 例如：UNUUffqyslhqU1dEaVMcFSy8nUg
FEISHU_FOLDER_TOKEN=

# 飞书多维表格字段说明（需要手动创建以下字段）：
# - 播客名称（单行文本）
# - Episode 标题（单行文本）
# - 发布时间（日期）
# - 节目页（URL）
# - 音频（URL）
# - 标签（多选）- 需要预设选项：RAG, Agent, Fine-tuning, 产品增长, 商业化, 等
# - 核心要点（多行文本）
# - Episode ID（单行文本）
